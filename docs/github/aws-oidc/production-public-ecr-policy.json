{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicRegistryLogin",
      "Effect": "Allow",
      "Action": "ecr-public:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PublicRegistryBearerToken",
      "Effect": "Allow",
      "Action": "sts:GetServiceBearerToken",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "sts:AWSServiceName": "ecr-public.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PublishLibraryImage",
      "Effect": "Allow",
      "Action": [
        "ecr-public:BatchCheckLayerAvailability",
        "ecr-public:InitiateLayerUpload",
        "ecr-public:UploadLayerPart",
        "ecr-public:CompleteLayerUpload",
        "ecr-public:PutImage"
      ],
      "Resource": "arn:aws:ecr-public::<AWS_ACCOUNT_ID>:repository/estimators-lib"
    }
  ]
}
